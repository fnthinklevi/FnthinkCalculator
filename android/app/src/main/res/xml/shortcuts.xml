<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="time_calculation"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_time"
        android:shortcutShortLabel="@string/shortcut_time_short"
        android:shortcutLongLabel="@string/shortcut_time_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.fnthink.FnthinkCalculator"
            android:targetClass="com.fnthink.FnthinkCalculator.MainActivity">
